<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
    vibrator is capable of subtle vibrations -->
    <bool name="config_vibrateOnIconAnimation">true</bool>

    <!-- Preferred max refresh rate at keyguard, if supported by the display. -->
    <integer name="config_keyguardMaxRefreshRate">60</integer>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
        relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">48.7</item>

    <!-- Color of the UDFPS pressed view -->
    <color name="config_udfpsColor">#00FFFFFF</color>

    <!-- Doze: does the single tap sensor need a proximity check? -->
    <bool name="doze_single_tap_proximity_check">true</bool>

    <!-- Doze: does the double tap sensor need a proximity check? -->
    <bool name="doze_double_tap_proximity_check">true</bool>

    <!-- Doze: does the pickup sensor need a proximity check? -->
    <bool name="doze_pickup_event_proximity_check">true</bool>

    <!-- Udfps vendor code -->
    <integer name="config_udfps_vendor_code">22</integer>
</resources>
